{
  "expo": {
    "name": "ChronKeep",
    "slug": "chronkeep-mobile",
    "scheme": "chronkeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victorabuchi.chronkeep",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17a06b",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.victorabuchi.chronkeep",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChronKeep to access your photos so you can add a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0d1015"
          },
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#3b5bdb",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca476104-d603-44b7-b753-d45c6e91c0dc"
      }
    },
    "owner": "victorabuchi"
  }
}
